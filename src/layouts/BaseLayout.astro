---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import { navLinks, navCta, siteBrand, siteLogo } from '../config/nav';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Shape and Code — Estudio Creativo',
  description = 'Diseño y estrategia digital para marcas que quieren crecer.',
} = Astro.props;

const year = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/assets/mark-black.png">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <ViewTransitions />
  <!-- Sin JS no hay reveal: los titulos deben verse igual. -->
  <noscript><style>[data-reveal-words] { visibility: visible; }</style></noscript>
</head>
<body class="bg-[#111111] text-[#f5f5f5] font-poppins antialiased">

  <Navbar
    logo={siteLogo}
    logoAlt={siteBrand}
    brand={siteBrand}
    links={navLinks}
    cta={navCta}
  />

  <!-- Envoltorio de ScrollSmoother (`scripts/scrollSmooth.ts`). El contenido va
       dentro porque el smoother lo desplaza con un `transform`; el `<Navbar>`
       queda fuera a propósito: dentro de un ancestro transformado, su
       `position: fixed` dejaría de referirse al viewport. El footer sí entra,
       o no scrollearía con la página. -->
  <div id="smooth-wrapper">
  <div id="smooth-content">

  <main class="overflow-x-clip">
    <slot />
  </main>

  <!-- FOOTER -->
  <footer class="bg-[#0a0a0a] text-[#fafafa] border-t border-[#1f1f1f]">
    <div class="max-w-[1320px] mx-auto px-4 sm:px-6 md:px-8 py-8 sm:py-11 flex flex-col sm:flex-row flex-wrap gap-5 sm:gap-6 justify-between items-start sm:items-center">
      <div class="flex items-center gap-3">
        <img src="/assets/mark-black.png" alt="" class="h-6 w-auto" style="filter: invert(1)" />
        <span class="font-extrabold text-[14px] tracking-[0.04em]">SHAPE AND CODE</span>
      </div>
      <div class="flex gap-4 sm:gap-[26px] text-[13px] sm:text-[13.5px] text-[#a3a3a3] flex-wrap">
        <a href="#" class="hover:text-[#fafafa] transition-colors">Instagram</a>
        <a href="#" class="hover:text-[#fafafa] transition-colors">Behance</a>
        <a href="#" class="hover:text-[#fafafa] transition-colors">LinkedIn</a>
      </div>
      <p class="font-space-mono text-[12px] text-[#737373]">© {year} — ESTUDIO CREATIVO</p>
    </div>
  </footer>

  </div>
  </div>

  <script>
    import { initScrollSmooth, destroyScrollSmooth } from '../scripts/scrollSmooth';
    import { initParallax, destroyParallax } from '../scripts/parallax';
    import { initServicesCarousel, destroyServicesCarousel } from '../scripts/servicesCarousel';
    import { initTextReveal, destroyTextReveal } from '../scripts/textReveal';

    // `astro:page-load` cubre la carga inicial y cada navegacion con
    // ViewTransitions; `astro:before-swap` revierte el SplitText y mata el
    // smoother antes de que el DOM se reemplace (si no, los wrappers del
    // SplitText se filtran al snapshot y el smoother apunta a nodos muertos).
    //
    // El orden importa: `initScrollSmooth` va primero porque `initParallax`
    // registra sus efectos contra esa instancia, y `initParallax` va al final
    // para que sus ScrollTriggers midan con el DOM ya montado.
    //
    // `initParallax` y `initServicesCarousel` hoy no hacen nada en estas
    // paginas (no hay `[data-hero-parallax]` ni `[data-services]`), pero dejan
    // el layout listo: basta anadir esos `data-*` al markup de cualquier
    // pagina para que el efecto funcione sin volver a tocar aqui.
    document.addEventListener('astro:page-load', () => {
      initScrollSmooth();
      initTextReveal();
      initParallax();
      initServicesCarousel();
    });
    document.addEventListener('astro:before-swap', () => {
      destroyServicesCarousel();
      destroyParallax();
      destroyTextReveal();
      destroyScrollSmooth();
    });
  </script>

</body>
</html>
