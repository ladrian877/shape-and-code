---
import '../styles/global.css';
import Marquee from '../components/Marquee';
import Navbar from '../components/Navbar.astro';
import Img from '../components/Img.astro';
import { navLinks, navCta, siteBrand, siteLogo } from '../config/nav';
import { workItems } from '../config/work';
import { ViewTransitions } from 'astro:transitions';

const marqueeItems = ['BRANDING','MARKETING DIGITAL','DISEÑO WEB','SEO / SEM','UX / UI','CAMPAÑAS','IDENTIDAD','ESTRATEGIA','AUTOMATIZACIONES'];

// `image` es opcional: la carta que la trae la usa de fondo (ver `.svc-media`).
// El valor es una clave del registro de imagenes: la ruta relativa a
// `src/assets/images/`. El componente <Img> la resuelve y sirve un WebP
// redimensionado (ver `src/assets/images/README.md`). Una clave inexistente
// rompe el build, no produce un 404.
const services: { num: string; title: string; desc: string; image?: string }[] = [
  { num: '01', title: 'Marketing digital y campañas', desc: 'Estrategia, paid media y embudos que convierten. Medimos cada peso invertido.', image: 'servicios/ServiciosMarketing.png' },
  { num: '02', title: 'Diseño web / UX-UI', desc: 'Sitios y productos rápidos, claros y pensados para convertir visitas en clientes.', image: 'servicios/ServiciosWeb.png' },
  { num: '03', title: 'Branding e identidad', desc: 'Marcas con criterio: naming, logotipo, sistema visual y guías de uso.' },
  { num: '04', title: 'SEO / SEM', desc: 'Posicionamiento orgánico y de pago para que te encuentren cuando importa.' },
  { num: '05', title: 'Automatizaciones', desc: 'Flujos, integraciones y procesos automáticos que ahorran tiempo y escalan tu operación.' },
];

const steps = [
  { num: 'P.01', title: 'Descubrimiento', desc: 'Entendemos tu negocio, audiencia y objetivos antes de tocar un pixel.' },
  { num: 'P.02', title: 'Estrategia', desc: 'Definimos el plan, los mensajes y los canales con métricas claras.' },
  { num: 'P.03', title: 'Diseño y build', desc: 'Creamos marca, web y piezas de campaña listas para lanzar.' },
  { num: 'P.04', title: 'Lanzar y optimizar', desc: 'Medimos, iteramos y escalamos lo que funciona.' },
];


const year = new Date().getFullYear();

---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shape and Code — Estudio Creativo</title>
  <meta name="description" content="Diseño y estrategia digital para marcas que quieren crecer." />
  <link rel="icon" href="/assets/mark-white.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <ViewTransitions />
  <!-- Sin JS no hay reveal ni timeline: todo debe verse igual. -->
  <noscript><style>
    [data-reveal-words],
    [data-hero-media], [data-hero-desc], [data-hero-cta], [data-hero-marquee],
    [data-estudio-model], [data-estudio-text], [data-estudio-stat],
    [data-cta-scramble], [data-cta-button],
    .has-hero-intro [data-navbar] { visibility: visible; }
  </style></noscript>
</head>
<body class="has-hero-intro bg-[#111111] text-[#f5f5f5] font-poppins antialiased">

  <Navbar
    logo={siteLogo}
    logoAlt={siteBrand}
    invertLogo={false}
    brand={siteBrand}
    links={navLinks}
    cta={navCta}
    homeHref="#top"
    morph
  />

  <!-- Panel de detalles al vuelo de las tarjetas de Trabajo. Lo rellena
       `scripts/animations/workHint.ts` copiando el `.work-card-overlay` de la
       tarjeta activa, por eso nace vacio.
       Fuera del wrapper por el mismo motivo que el `<Navbar>`: se posiciona en
       coordenadas de viewport y dentro de un ancestro transformado su
       `position: fixed` dejaria de referirse al viewport. Ademas asi se libra
       del `overflow: hidden` de `.work-stage`.
       `aria-hidden` porque su contenido es una copia: el original sigue en el
       DOM de la tarjeta y es el que leen los lectores de pantalla. -->
  <div data-work-hint class="work-hint" aria-hidden="true"></div>

  <!-- Cursor trail de la seccion CTA (`scripts/animations/ctaTrail.ts`).
       Mismo motivo que `.work-hint` arriba: fuera del wrapper de
       ScrollSmoother para que `position: fixed` siga refiriendose al
       viewport. Puramente decorativo, de ahi `aria-hidden`. -->
  <div data-cta-trail aria-hidden="true">
    <Img src="cta-trail/01-app.png" alt="" preset="ctaTrail" class="cta-trail-img" data-cta-trail-img />
    <Img src="cta-trail/02-branding.png" alt="" preset="ctaTrail" class="cta-trail-img" data-cta-trail-img />
    <Img src="cta-trail/03-web.png" alt="" preset="ctaTrail" class="cta-trail-img" data-cta-trail-img />
    <Img src="cta-trail/04-packaging.png" alt="" preset="ctaTrail" class="cta-trail-img" data-cta-trail-img />
    <Img src="cta-trail/05-social.png" alt="" preset="ctaTrail" class="cta-trail-img" data-cta-trail-img />
    <Img src="cta-trail/06-poster.png" alt="" preset="ctaTrail" class="cta-trail-img" data-cta-trail-img />
  </div>

  <!-- Envoltorio de ScrollSmoother (`scripts/scrollSmooth.ts`). El contenido va
       dentro porque el smoother lo desplaza con un `transform`; el `<Navbar>`
       queda fuera a propósito: dentro de un ancestro transformado, su
       `position: fixed` dejaría de referirse al viewport. -->
  <div id="smooth-wrapper">
  <div id="smooth-content">
  <main id="top" class="overflow-x-clip">

    <!-- HERO — ocupa el viewport completo y cierra con la banda del marquee -->
    <section id="hero" class="section-full relative" data-hero>
      <!-- Contenedor mas ancho que el resto de secciones (1320px) para que el
           titulo arranque mas a la izquierda en pantallas grandes. `flex-1`
           hace que este bloque se quede con el alto sobrante y centre su
           contenido, dejando el marquee pegado al fondo del hero. -->
      <div class="relative flex-1 w-full flex flex-col justify-center max-w-[1560px] mx-auto px-4 sm:px-6 md:px-8 pt-[100px] sm:pt-[clamp(96px,11.5vh,170px)] pb-12 sm:pb-[clamp(36px,6vh,64px)]">
        <!-- Model image — decorative, behind all content.
             El wrapper existe solo para separar dueños del `transform`: el
             parallax del scroll escribe sobre `[data-hero-parallax]` y la
             timeline de entrada sobre `[data-hero-media]`. Si compartieran
             elemento, uno pisaría al otro. -->
        <div data-hero-parallax class="absolute inset-0 pointer-events-none" style="z-index: 0;">
          <Img
            src="hero/backgroundasset.png"
            preset="hero"
            alt=""
            aria-hidden="true"
            data-hero-media
            class="hero-model hidden md:block absolute bottom-[-15px] h-[78%] w-auto object-contain object-bottom pointer-events-none select-none md:right-[-24%]"
          />
          <!-- Móvil: fondo a pantalla completa, centrado, cover. No lleva
               `data-hero-media`: `heroIntro.ts` usa querySelector singular
               sobre ese atributo, así que un segundo elemento con el mismo
               quedaría con `visibility:hidden` para siempre. -->
          <Img
            src="hero/backgroundasset-mobile.png"
            preset="heroMobile"
            alt=""
            aria-hidden="true"
            class="hero-model-mobile block md:hidden absolute inset-0 w-full h-full object-cover object-center pointer-events-none select-none"
          />
          <div class="hero-scrim block md:hidden absolute inset-0 pointer-events-none" aria-hidden="true"></div>
        </div>
        <!-- Hero content -->
        <div class="relative flex flex-col items-start text-left" style="z-index: 1;">
          <h1 data-reveal-words data-hero-title class="hero-title font-bold leading-[0.94] tracking-[-0.035em] max-w-[12ch]" style="font-size: clamp(34px, min(7.6vw, 10.8vh), 116px)">
            Marcas que venden. Campañas que se recuerdan.
          </h1>
          <div class="hero-bottom mt-8 sm:mt-[clamp(20px,4vh,48px)] flex flex-col items-start gap-6 sm:gap-[clamp(16px,2.6vh,32px)]">
            <p data-hero-desc class="hero-desc text-[#a3a3a3] leading-[1.5] max-w-[46ch]" style="font-size: clamp(16px, min(1.5vw, 2.4vh), 21px)">
              Construimos identidad, sitios y campañas que convierten atención en clientes.
            </p>
            <div data-hero-cta class="flex gap-[10px] sm:gap-[14px] flex-wrap shrink-0">
              <a href="#contacto" class="inline-flex items-center gap-[10px] bg-[#f5f5f5] text-[#111111] text-[14px] sm:text-[15px] font-semibold px-5 sm:px-[26px] py-[13px] sm:py-[15px] rounded-full hover:bg-[#d4d4d4] transition-colors">
                Empezar un proyecto <span class="svc-arrow">↗</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- MARQUEE BAND — a todo el ancho, cerrando el hero -->
      <div data-hero-marquee class="relative border-t border-[#2a2a2a] border-b overflow-hidden bg-[#111111]" style="z-index: 1;">
        <Marquee client:load items={marqueeItems} />
      </div>
    </section>

    <!-- SERVICIOS — banda negra a todo el ancho, carrusel horizontal.
         El titulo va en su contenedor de 1320px; el track sale a ancho
         completo para poder recorrer toda la pantalla y se realinea con el
         titulo mediante su propio `padding-inline` (ver `.svc-track`).
         Cada carta admite una imagen de fondo opcional: basta anadir `image`
         a su entrada del array `services` (ver `.svc-media`). -->
    <section id="servicios" class="section-full bg-[#0a0a0a] text-[#fafafa]" data-services>
      <div class="w-full max-w-[1320px] mx-auto px-4 sm:px-6 md:px-8 pt-14 sm:pt-[clamp(56px,9vh,104px)]">
        <div class="flex justify-between items-end flex-wrap gap-4 mb-6 sm:mb-8">
          <h2 data-services-title data-reveal-words class="font-extrabold tracking-[-0.03em] leading-none" style="font-size: clamp(26px, min(4vw, 7vh), 56px)">SERVICIOS</h2>
          <!-- Referencia de avance: con una tarjeta por pantalla y sin
               scrollbar visible, si no es facil perder la cuenta. -->
          <div class="svc-progress-rail" aria-hidden="true">
            <span data-svc-progress class="svc-progress-bar"></span>
          </div>
        </div>
      </div>

      <div data-svc-viewport class="svc-viewport">
        <div data-svc-track class="svc-track">
          {services.map((s) => (
            <a href="/servicios" data-svc-card class="svc-card">
              {s.image && (
                <span class="svc-media" aria-hidden="true">
                  <Img src={s.image} preset="card" alt="" />
                </span>
              )}
              {/* `relative z-[1]`: `.svc-media` es `absolute` y sin esto taparia
                  al contenido en flujo. */}
              <span class="svc-num relative z-[1] text-[12px] sm:text-[14px] opacity-[0.55]">{s.num}</span>
              <div class="mt-auto relative z-[1]">
                <h3 class="svc-title font-bold tracking-[-0.025em] leading-[1.02]" style="font-size: clamp(28px, min(5.5vw, 8vh), 68px)">{s.title}</h3>
                <p class="svc-desc mt-4 max-w-[52ch] leading-[1.5] opacity-70" style="font-size: clamp(14px, min(1.7vw, 2.6vh), 19px)">{s.desc}</p>
              </div>
              <span class="svc-arrow absolute z-[1] top-[clamp(20px,3vw,44px)] right-[clamp(20px,3vw,44px)]">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- PROCESO -->
    <!-- <section id="proceso" class="section-full max-w-[1320px] mx-auto px-4 sm:px-6 md:px-8 py-14 sm:py-[clamp(48px,7.5vh,84px)]">
      <div class="flex justify-between items-end flex-wrap gap-4 mb-8 sm:mb-12">
        <h2 data-reveal-words class="font-extrabold tracking-[-0.03em] leading-none max-w-[16ch]" style="font-size: clamp(26px, min(4vw, 7vh), 56px)">Un método claro, sin sorpresas</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-[#2a2a2a] border border-[#2a2a2a]">
        {steps.map((step, i) => (
          <div class="bg-[#1a1a1a] hover:bg-[#252525] transition-colors pt-7 sm:pt-8 px-5 sm:px-[26px] pb-8 sm:pb-10 min-h-[180px] sm:min-h-[clamp(170px,26vh,220px)] flex flex-col justify-between">
            <span class="text-[13px] text-[#8a8a8a]">{step.num}</span>
            <div>
              <h3 class="text-[18px] sm:text-[20px] font-bold tracking-[-0.01em] mb-[10px]">{step.title}</h3>
              <p class="text-[13.5px] sm:text-[14.5px] leading-[1.5] text-[#a3a3a3]">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section> -->

    <!-- TRABAJO -->
    <!--
      El titular va en `z-10` y las tarjetas en `z-20`: pasan por DELANTE y lo
      tapan a ratos. Ese solape es el efecto, así que el `<h2>` no se atenúa ni
      se enmascara. Tampoco lleva `data-reveal-words`: ese atributo arranca en
      `visibility: hidden` (ver `global.css`) y pelearía con el fijado.
      El movimiento lo monta `scripts/animations/workParallax.ts`.
    -->
    <section id="trabajo" data-work class="bg-[#0a0a0a]">
      <div data-work-stage class="work-stage">
        <div class="work-heading">
          <h2 class="work-title">ESTO ES LO QUE HACEMOS</h2>
          <p class="work-eyebrow">(Desliza para explorar)</p>
        </div>

        <ul class="work-cards">
          {workItems.map((item) => (
            <li
              class="work-card"
              data-work-card
              data-speed={item.speed}
              data-start={item.start}
              data-end={item.end}
              data-hint-side={item.hintSide}
              style={`--work-w: ${item.width}px; --work-x: ${item.xOffset}; --work-rot: ${item.rotation}deg; --work-aspect: ${item.aspect};`}
            >
              <a
                href={item.link ?? '/proyectos'}
                target={item.link ? '_blank' : undefined}
                rel={item.link ? 'noopener noreferrer' : undefined}
                class="work-card-link"
              >
                <div class="work-card-media">
                  {item.image ? (
                    <Img src={item.image} preset="preview" alt={item.alt} class="work-card-img" />
                  ) : (
                    <span class="work-card-hole" aria-hidden="true"></span>
                  )}
                </div>
                <div class="work-card-overlay">
                  <h3 class="work-card-name">{item.name}</h3>
                  <p class="work-card-desc">{item.description}</p>
                  <p class="work-card-meta">{item.tag} — {item.year}</p>
                  <span class="work-card-pill">Ver proyecto</span>
                </div>
                <!-- Móvil: nombre fuera de la imagen (ver `.work-card-overlay`
                     arriba, oculto en móvil). `aria-hidden` porque duplica el
                     nombre ya presente en el overlay y en el `alt` de la imagen. -->
                <div class="work-card-caption" aria-hidden="true">
                  <h3 class="work-card-caption-name">{item.name}</h3>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- <div class="work-cta">
        <a href="/proyectos" class="inline-flex items-center gap-[10px] border border-[#f5f5f5] text-[14px] sm:text-[15px] font-semibold px-6 sm:px-[30px] py-[13px] sm:py-[15px] rounded-full hover:bg-[#f5f5f5] hover:text-[#111111] transition-colors duration-200">
          Ver todos los proyectos <span class="svc-arrow">↗</span>
        </a>
      </div> -->
    </section>

    <!-- ESTUDIO -->
    <section id="estudio" class="section-full border-t border-[#2a2a2a] bg-[#111111]" data-estudio>
      <div class="max-w-[1320px] mx-auto px-4 sm:px-6 md:px-8 py-14 sm:py-[clamp(48px,8vh,96px)] grid grid-cols-1 md:grid-cols-[0.8fr_1.4fr] gap-8 md:gap-12">
        <Img
          src="estudio/bunnymodel4.png"
          alt=""
          preset="studioModel"
          data-estudio-model
          class="w-[240px] sm:w-[300px] md:w-[380px] h-auto object-contain mx-auto md:mx-0"
        />
        <div>
          <p class="leading-[1.28] tracking-[-0.02em] font-medium mb-10 sm:mb-14" style="font-size: clamp(20px, min(3vw, 5vh), 40px)" data-estudio-text>
            Creemos en el diseño con propósito. Cada proyecto une <strong class="font-extrabold">estética</strong> y <strong class="font-extrabold">estrategia</strong> para que tu marca no solo se vea bien — funcione y crezca.
          </p>
          <div class="flex gap-8 sm:gap-14 flex-wrap border-t border-[#2a2a2a] pt-8">
            <div data-estudio-stat>
              <div class="text-[36px] sm:text-[44px] font-extrabold tracking-[-0.03em]" data-count-to="40">+40</div>
              <div class="text-[13px] sm:text-[14px] text-[#8a8a8a] mt-1">proyectos entregados</div>
            </div>
            <div data-estudio-stat>
              <div class="text-[36px] sm:text-[44px] font-extrabold tracking-[-0.03em]" data-count-to="8">8 años</div>
              <div class="text-[13px] sm:text-[14px] text-[#8a8a8a] mt-1">de experiencia combinada</div>
            </div>
            <div data-estudio-stat>
              <div class="text-[36px] sm:text-[44px] font-extrabold tracking-[-0.03em]" data-count-to="100">100%</div>
              <div class="text-[13px] sm:text-[14px] text-[#8a8a8a] mt-1">enfoque a resultados</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section id="contacto" class="section-full bg-[#0a0a0a] text-[#fafafa]" data-cta>
      <div class="max-w-[1320px] mx-auto px-4 sm:px-6 md:px-8 py-16 sm:py-[clamp(56px,10vh,112px)]">
        <h2 data-cta-scramble class="font-extrabold leading-[0.95] tracking-[-0.035em] max-w-[13ch] break-words" style="font-size: clamp(34px, min(8vw, 13vh), 116px)">¿Hacemos crecer tu marca?</h2>
        <div class="flex flex-col sm:flex-row flex-wrap gap-6 sm:gap-10 justify-between items-start sm:items-end mt-10 sm:mt-[clamp(32px,5vh,56px)]">
          <a href="mailto:hola@shapeandcode.agency" data-cta-scramble class="font-semibold tracking-[-0.02em] border-b-2 border-[#8a8a8a] pb-[6px] hover:border-[#fafafa] transition-colors break-all" style="font-size: clamp(15px, min(3vw, 5vh), 38px)">
            hola@shapeandcode.agency
          </a>
          <a href="mailto:hola@shapeandcode.agency" data-cta-button class="inline-flex items-center gap-3 bg-[#fafafa] text-[#0a0a0a] text-[14px] sm:text-[16px] font-bold px-6 sm:px-8 py-4 sm:py-[18px] rounded-full hover:bg-[#d4d4d4] transition-colors shrink-0">
            Escribir un mensaje <span class="svc-arrow">↗</span>
          </a>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="bg-[#0a0a0a] text-[#fafafa] border-t border-[#1f1f1f]">
      <div class="max-w-[1320px] mx-auto px-4 sm:px-6 md:px-8 py-8 sm:py-11 flex flex-col sm:flex-row flex-wrap gap-5 sm:gap-6 justify-between items-start sm:items-center">
        <div class="flex items-center gap-3">
          <img src="/assets/mark-white.svg" alt="" class="h-6 w-auto" />
          <span class="font-extrabold text-[14px] tracking-[0.04em]">SHAPE AND CODE</span>
        </div>
        <div class="flex gap-4 sm:gap-[26px] text-[13px] sm:text-[13.5px] text-[#a3a3a3] flex-wrap">
          <a href="#" class="hover:text-[#fafafa] transition-colors">Instagram</a>
          <a href="#" class="hover:text-[#fafafa] transition-colors">Behance</a>
          <a href="#" class="hover:text-[#fafafa] transition-colors">LinkedIn</a>
        </div>
        <p class="text-[12px] text-[#737373]">© {year} — ESTUDIO CREATIVO</p>
      </div>
    </footer>

  </main>
  </div>
  </div>

  <script>
    import { initScrollSmooth, destroyScrollSmooth } from '../scripts/scrollSmooth';
    import { initParallax, destroyParallax } from '../scripts/parallax';
    import { initServicesCarousel, destroyServicesCarousel } from '../scripts/servicesCarousel';
    import { initNavMorph, destroyNavMorph } from '../scripts/navMorph';
    import { initTextReveal, destroyTextReveal } from '../scripts/textReveal';
    import { initHeroIntro, destroyHeroIntro } from '../scripts/animations/heroIntro';
    import { initStudioIntro, destroyStudioIntro } from '../scripts/animations/studioIntro';
    import { initCtaIntro, destroyCtaIntro } from '../scripts/animations/ctaIntro';
    import { initWorkParallax, destroyWorkParallax } from '../scripts/animations/workParallax';
    import { initWorkHint, destroyWorkHint } from '../scripts/animations/workHint';
    import { initCtaTrail, destroyCtaTrail } from '../scripts/animations/ctaTrail';

    // `astro:page-load` cubre la carga inicial y cada navegacion con
    // ViewTransitions; `astro:before-swap` limpia listeners y ScrollTriggers
    // antes de que el DOM se reemplace.
    //
    // El orden importa: `initScrollSmooth` va primero porque `initParallax`
    // registra sus efectos contra esa instancia, y los modulos dirigidos por
    // scroll van al final para que sus ScrollTriggers midan el DOM ya montado.
    document.addEventListener('astro:page-load', () => {
      initScrollSmooth();
      initNavMorph();
      // La intro del hero se queda con el H1 (`data-hero-title`); textReveal
      // cubre el resto de titulos con `data-reveal-words`.
      initHeroIntro();
      initTextReveal();
      initParallax();
      initServicesCarousel();
      initStudioIntro();
      initCtaIntro();
      initWorkParallax();
      initWorkHint();
      initCtaTrail();
    });
    document.addEventListener('astro:before-swap', () => {
      destroyCtaTrail();
      destroyWorkHint();
      destroyWorkParallax();
      destroyCtaIntro();
      destroyStudioIntro();
      destroyServicesCarousel();
      destroyParallax();
      destroyTextReveal();
      destroyHeroIntro();
      destroyNavMorph();
      destroyScrollSmooth();
    });
  </script>

  <style>
    /* ---- HERO MOBILE BACKGROUND + SCRIM ----
       En móvil el fondo `.hero-model-mobile` cubre toda la sección; el scrim
       aporta el contraste base contra el texto. */
    @media (max-width: 767px) {
      .hero-model-mobile {
        filter: none;
        -webkit-mask-image: none;
        mask-image: none;
      }
      .hero-scrim {
        background: linear-gradient(
          180deg,
          rgba(10, 10, 10, 0.35) 0%,
          rgba(10, 10, 10, 0.6) 55%,
          rgba(10, 10, 10, 0.72) 100%
        );
      }
    }

    /* ---- HERO TITLE LEGIBILITY (solo móvil) ----
       Refuerzo suave sobre el scrim de `.hero-scrim` (arriba): intensidad
       reducida a la mitad respecto al halo original, que hacía todo el
       trabajo de contraste antes de que existiera el scrim. */
    @media (max-width: 639px) {
      .hero-title {
        text-shadow:
          0 0 10px rgba(0, 0, 0, 0.42),
          0 0 4px rgba(0, 0, 0, 0.4),
          0 1px 2px rgba(0, 0, 0, 0.3);
      }
      /* Halo más ligero para el texto descriptivo (fuente más pequeña). */
      .hero-desc {
        text-shadow:
          0 0 7px rgba(0, 0, 0, 0.45),
          0 0 3px rgba(0, 0, 0, 0.42);
      }
    }

    /* ---- CARRUSEL DE SERVICIOS ----

       Por defecto el viewport es un scroller horizontal nativo con snap: ese
       es el estado sin JS y con `prefers-reduced-motion`, y se arrastra a mano
       perfectamente. `scripts/servicesCarousel.ts` añade `.is-pinned` cuando
       toma el control y apaga ese scroll para que no compita con el tween. */
    .svc-viewport {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      /* La barra de progreso ya indica el avance; la scrollbar nativa sobra. */
      scrollbar-width: none;
      padding-bottom: clamp(40px, 6vh, 64px);
    }
    .svc-viewport::-webkit-scrollbar { display: none; }
    .svc-viewport.is-pinned { overflow-x: hidden; scroll-snap-type: none; }

    .svc-track {
      display: flex;
      gap: clamp(14px, 1.6vw, 28px);
      /* Alinea la primera tarjeta con el título (que vive en un contenedor de
         1320px) aunque el track vaya a ancho completo. */
      padding-inline: max(1rem, calc((100vw - 1320px) / 2 + 1rem));
    }
    @media (min-width: 640px) { .svc-track { padding-inline: max(1.5rem, calc((100vw - 1320px) / 2 + 1.5rem)); } }
    @media (min-width: 768px) { .svc-track { padding-inline: max(2rem, calc((100vw - 1320px) / 2 + 2rem)); } }

    .svc-card {
      position: relative;
      flex: 0 0 auto;
      width: min(86vw, 1040px);
      min-height: clamp(300px, 52vh, 560px);
      scroll-snap-align: center;
      display: flex;
      flex-direction: column;
      padding: clamp(20px, 3vw, 44px);
      border: 1px solid #2a2a2a;
      border-radius: 4px;
      isolation: isolate;
      transition: background-color 0.3s, border-color 0.3s;
    }
    /* Sin imagen el zoom no aplica: un fondo discreto da la respuesta al hover.
       Con imagen esta capa queda tapada por `.svc-media`, asi que no estorba. */
    .svc-card:hover { background: #1a1a1a; }

    /* ---- IMAGEN DE FONDO DE LA CARTA ----
       Capa propia (y no `background-image` de la carta) porque el hover escala
       la imagen y el degradado de legibilidad NO debe escalar con ella. */
    .svc-media {
      position: absolute;
      /* `inset: 0` se posiciona al padding box: el borde de la carta queda visible. */
      inset: 0;
      z-index: 0;
      overflow: hidden;
      border-radius: inherit;
    }
    .svc-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
      transform: scale(1);
      transition: transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
    }
    .svc-card:hover .svc-media img { transform: scale(1.05); }

    @media (prefers-reduced-motion: reduce) {
      .svc-media img { transition: none; }
      .svc-card:hover .svc-media img { transform: none; }
    }

    /* Degradado de legibilidad: el texto va en #fafafa abajo a la izquierda.
       Uno vertical para titulo/descripcion y otro horizontal para el resto de
       la columna de texto. */
    .svc-media::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        linear-gradient(to top, rgba(10,10,10,0.92) 0%, rgba(10,10,10,0.55) 45%, rgba(10,10,10,0.15) 100%),
        linear-gradient(to right, rgba(10,10,10,0.75) 0%, rgba(10,10,10,0) 60%);
    }

    .svc-progress-rail { width: clamp(80px, 18vw, 220px); height: 2px; background: #2a2a2a; }
    .svc-progress-bar {
      display: block;
      height: 100%;
      background: #fafafa;
      transform: scaleX(0);
      transform-origin: left center;
    }

    /* ---- TRABAJO: titular fijo y tarjetas en parallax ----

       El estado base (el de aqui abajo, sin media query) es el de movil y el de
       `prefers-reduced-motion`: columna estatica, tarjetas visibles, sin nada
       que dependa de JS. El parallax se monta solo dentro de la media query del
       final, que es gemela de la rama desktop de `workParallax.ts`: la
       disposicion absoluta y la animacion que la mueve tienen que aparecer y
       desaparecer juntas, o las tarjetas quedarian apiladas sin nada que las
       separase. */

    .work-stage {
      max-width: 1320px;
      margin: 0 auto;
      padding: clamp(56px, 9vh, 104px) 16px 0;
    }
    .work-heading { text-align: center; }
    .work-title {
      font-size: clamp(1.9rem, 8vw, 3rem);
      font-weight: 600;
      /* Poppins es geometrica: a tamaños grandes se dispersa sin este negativo. */
      letter-spacing: -0.04em;
      line-height: 0.95;
      color: #f5f5f5;
      /* El titular es de longitud variable: se limita por medida (ch) y no por
         píxeles, así el salto de línea cae donde toca aunque cambie el texto.
         `balance` reparte las líneas en vez de dejar una suelta. */
      max-width: 15ch;
      margin-inline: auto;
      text-wrap: balance;
    }
    .work-eyebrow {
      margin-top: 24px;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: #8a8a8a;
    }

    .work-cards {
      margin-top: clamp(36px, 6vh, 56px);
      display: grid;
      gap: 28px;
      justify-items: center;
      list-style: none;
      padding: 0;
    }
    .work-card { width: min(100%, 420px); }

    .work-card-link {
      display: block;
      position: relative;
      border-radius: 20px;
      overflow: hidden;
      background: #1a1a1a;
      /* Sobre #111111 el borde es lo que define el canto de la tarjeta. Sin
         sombras: sobre fondo oscuro no se ven y solo pesan al pintar. */
      border: 1px solid #2a2a2a;
    }
    .work-card-link:focus-visible { outline: 2px solid #f5f5f5; outline-offset: 3px; }

    /* Hueco con la relacion de aspecto ya reservada: la imagen entra despues
       sin mover el layout (nada de CLS). */
    .work-card-media {
      position: relative;
      aspect-ratio: var(--work-aspect, 4 / 3);
      background: #1f1f1f;
    }
    .work-card-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    /* Placeholder discreto: marco fino, sin icono ni texto. */
    .work-card-hole {
      position: absolute;
      inset: 24px;
      border: 1px solid #2a2a2a;
      border-radius: 10px;
    }

    .work-card-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-end;
      gap: 8px;
      padding: 24px;
      background: rgba(10, 10, 10, 0.85);
      transition: opacity 300ms ease;
    }
    .work-card-name { font-size: 18px; font-weight: 600; letter-spacing: -0.01em; color: #fafafa; }
    .work-card-desc { font-size: 14px; line-height: 1.45; color: #a3a3a3; }
    .work-card-meta { font-size: 12px; color: #8a8a8a; }
    /* El punto mas luminoso de toda la seccion. */
    .work-card-pill {
      margin-top: 6px;
      display: inline-flex;
      align-items: center;
      background: #f5f5f5;
      color: #111111;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 9px 16px;
      border-radius: 999px;
    }

    .work-cta {
      display: flex;
      justify-content: center;
      padding: clamp(36px, 6vh, 64px) 16px clamp(48px, 7.5vh, 84px);
    }

    /* ---- Trabajo: móvil ----
       Sin cursor ni panel flotante, el overlay (etiqueta+CTA sobre la
       imagen) se oculta y el nombre pasa a un caption fuera de la imagen,
       para priorizar la visibilidad de la imagen. Todas las tarjetas
       comparten el mismo aspect-ratio: el ancho ya era uniforme
       (`.work-card`), así queda también el alto. Oculto por defecto: solo
       existe para móvil, el `<h3>` duplicado no debe pintarse en desktop. */
    .work-card-caption { display: none; }

    @media (max-width: 767px) {
      .work-card-overlay { display: none; }

      .work-card-caption { display: block; padding: 12px 4px 0; }
      .work-card-caption-name {
        font-size: 15px;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: #fafafa;
      }

      .work-card-media { aspect-ratio: 4 / 3; }
    }

    /* ---- Panel de detalles al vuelo (`scripts/animations/workHint.ts`) ----

       Nace vacio e invisible; el modulo lo rellena y lo coloca. Se posiciona
       por `transform` desde la esquina superior izquierda del viewport, que es
       lo que GSAP anima con `quickTo`. */
    .work-hint {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 60;
      /* Nunca debe robarle el hover a la tarjeta que tiene debajo: si lo
         hiciera, el propio panel dispararia el `pointerleave` de la tarjeta y
         se cerraria solo. */
      pointer-events: none;
      opacity: 0;
      visibility: hidden;
      width: max-content;
      max-width: 300px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding: 18px 20px;
      border-radius: 14px;
      background: #1a1a1a;
      border: 1px solid #2a2a2a;
      transform-origin: center;
      will-change: transform;
    }
    /* El contenido es una copia del overlay, asi que reutiliza sus clases y
       solo se ajusta lo que cambia de escala en este contexto. */
    .work-hint .work-card-name { font-size: 16px; }
    .work-hint .work-card-desc { font-size: 13px; }

    /* ---- Cursor trail de CTA (`scripts/animations/ctaTrail.ts`) ----

       Las 6 se pintan de una vez y el modulo las recicla en vez de crear/
       destruir nodos: `opacity: 0` en reposo, el script las mueve y las hace
       visibles al vuelo con `autoAlpha`. Mismo `z-index` que `.work-hint`
       porque nunca coexisten en pantalla. */
    .cta-trail-img {
      position: fixed;
      top: 0;
      left: 0;
      width: 180px;
      height: 180px;
      border-radius: 12px;
      border: 1px solid #2a2a2a;
      object-fit: cover;
      pointer-events: none;
      opacity: 0;
      z-index: 60;
      will-change: transform, opacity;
    }

    @media (min-width: 768px) {
      /* Sin `nowrap`: el titular ocupa varias palabras y forzarlo a una linea
         lo desbordaria o lo dejaria minusculo. Envuelve por medida y crece con
         el viewport hasta un techo comodo. */
      .work-title { font-size: clamp(3rem, 7vw, 6.5rem); }
      /* En escritorio el copy sale en el panel flotante (`.work-hint`), asi que
         el overlay se queda apagado y la imagen no se oscurece nunca. No se
         oculta con `display: none` a proposito: su texto sigue en el arbol de
         accesibilidad, que es de donde lo leen los lectores de pantalla y de
         donde lo copia `workHint.ts`.
         En movil no hay cursor ni panel, y por eso ahi sigue visible. */
      .work-card-overlay { opacity: 0; }
    }

    /* `.is-parallax` la pone `workParallax.ts` al tomar el control. Sin JS no se
       añade nunca y manda la columna estatica de arriba, que se lee igual de
       bien: las tarjetas no quedan amontonadas en absoluto sin nada que las
       mueva. */
    @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
      .work-stage.is-parallax {
        position: relative;
        height: 100vh;
        max-width: none;
        margin: 0;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }
      /* Titular detras (z-10), tarjetas delante (z-20): el solape es el efecto,
         asi que el titulo no se atenua ni se enmascara. */
      .is-parallax .work-heading { position: relative; z-index: 10; }
      .is-parallax .work-cards {
        position: absolute;
        inset: 0;
        z-index: 20;
        display: block;
        margin: 0;
        gap: 0;
        /* La capa no debe robar el cursor al resto de la seccion; cada tarjeta
           lo recupera por su cuenta. */
        pointer-events: none;
      }
      .is-parallax .work-card {
        position: absolute;
        top: 0;
        /* `--work-x` es el desplazamiento respecto al centro, en vw. */
        left: calc(50% + var(--work-x, 0) * 1vw);
        width: var(--work-w, 320px);
        margin-left: calc(var(--work-w, 320px) / -2);
        pointer-events: auto;
        will-change: transform;
      }
      /* La rotacion va en el hijo: GSAP escribe `transform` en `.work-card` y
         se la comeria. */
      .is-parallax .work-card-link { transform: rotate(var(--work-rot, 0deg)); }
    }
  </style>

</body>
</html>
