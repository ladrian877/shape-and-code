---
import '../styles/global.css';
import Marquee from '../components/Marquee';
import Navbar from '../components/Navbar.astro';
import { navLinks, navCta, siteBrand, siteLogo } from '../config/nav';
import { ViewTransitions } from 'astro:transitions';

const marqueeItems = ['BRANDING','MARKETING DIGITAL','DISEÑO WEB','SEO / SEM','UX / UI','CAMPAÑAS','IDENTIDAD','ESTRATEGIA','AUTOMATIZACIONES'];

// `image` es opcional: la carta que la trae la usa de fondo (ver `.svc-media`).
// Las imagenes van en `public/assets/` y se sirven TAL CUAL, sin pasar por
// `astro:assets`: la recompresion a WebP restaba calidad. A cambio pesan lo que
// pese el original, asi que conviene exportarlas ya optimizadas.
const services: { num: string; title: string; desc: string; image?: string }[] = [
  { num: '01', title: 'Marketing digital y campañas', desc: 'Estrategia, paid media y embudos que convierten. Medimos cada peso invertido.', image: '/assets/ServiciosMarketing.png' },
  { num: '02', title: 'Diseño web / UX-UI', desc: 'Sitios y productos rápidos, claros y pensados para convertir visitas en clientes.', image: '/assets/ServiciosWeb.png' },
  { num: '03', title: 'Branding e identidad', desc: 'Marcas con criterio: naming, logotipo, sistema visual y guías de uso.' },
  { num: '04', title: 'SEO / SEM', desc: 'Posicionamiento orgánico y de pago para que te encuentren cuando importa.' },
  { num: '05', title: 'Automatizaciones', desc: 'Flujos, integraciones y procesos automáticos que ahorran tiempo y escalan tu operación.' },
];

const steps = [
  { num: 'P.01', title: 'Descubrimiento', desc: 'Entendemos tu negocio, audiencia y objetivos antes de tocar un pixel.' },
  { num: 'P.02', title: 'Estrategia', desc: 'Definimos el plan, los mensajes y los canales con métricas claras.' },
  { num: 'P.03', title: 'Diseño y build', desc: 'Creamos marca, web y piezas de campaña listas para lanzar.' },
  { num: 'P.04', title: 'Lanzar y optimizar', desc: 'Medimos, iteramos y escalamos lo que funciona.' },
];

const work = [
  { name: 'Jadoo', tag: 'Web', year: '2026', image: '/assets/previews/JadooPreview.png', link: 'https://jadoo-astro.vercel.app/' },
  { name: 'NovaVision', tag: 'UX/UI + SEO', year: '2025', image: '/assets/previews/NeoVisionPreview.png', link: 'https://nova-vision-three.vercel.app/' },
  { name: 'Cobalt Fintech', tag: 'UX/UI + SEO', year: '2025' },
  { name: 'Vela Estudio', tag: 'Identidad', year: '2025' },
];

const year = new Date().getFullYear();

---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shape and Code — Estudio Creativo</title>
  <meta name="description" content="Diseño y estrategia digital para marcas que quieren crecer." />
  <link rel="icon" href="/assets/mark-white.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <ViewTransitions />
  <!-- Sin JS no hay reveal ni timeline: todo debe verse igual. -->
  <noscript><style>
    [data-reveal-words],
    [data-hero-media], [data-hero-desc], [data-hero-cta], [data-hero-marquee],
    .has-hero-intro [data-navbar] { visibility: visible; }
  </style></noscript>
</head>
<body class="has-hero-intro bg-[#111111] text-[#f5f5f5] font-poppins antialiased">

  <Navbar
    logo={siteLogo}
    logoAlt={siteBrand}
    brand={siteBrand}
    links={navLinks}
    cta={navCta}
    homeHref="#top"
    morph
  />

  <!-- Envoltorio de ScrollSmoother (`scripts/scrollSmooth.ts`). El contenido va
       dentro porque el smoother lo desplaza con un `transform`; el `<Navbar>`
       queda fuera a propósito: dentro de un ancestro transformado, su
       `position: fixed` dejaría de referirse al viewport. -->
  <div id="smooth-wrapper">
  <div id="smooth-content">
  <main id="top" class="overflow-x-clip">

    <!-- HERO — ocupa el viewport completo y cierra con la banda del marquee -->
    <section id="hero" class="section-full relative" data-hero>
      <!-- Contenedor mas ancho que el resto de secciones (1320px) para que el
           titulo arranque mas a la izquierda en pantallas grandes. `flex-1`
           hace que este bloque se quede con el alto sobrante y centre su
           contenido, dejando el marquee pegado al fondo del hero. -->
      <div class="relative flex-1 w-full flex flex-col justify-center max-w-[1560px] mx-auto px-4 sm:px-6 md:px-8 pt-[100px] sm:pt-[clamp(96px,11.5vh,170px)] pb-12 sm:pb-[clamp(36px,6vh,64px)]">
        <!-- Model image — decorative, behind all content.
             El wrapper existe solo para separar dueños del `transform`: el
             parallax del scroll escribe sobre `[data-hero-parallax]` y la
             timeline de entrada sobre `[data-hero-media]`. Si compartieran
             elemento, uno pisaría al otro. -->
        <div data-hero-parallax class="absolute inset-0 pointer-events-none" style="z-index: 0;">
          <img
            src="/assets/backgroundasset.png"
            alt=""
            aria-hidden="true"
            data-hero-media
            class="hero-model absolute bottom-[-15px] h-[78%] w-auto object-contain object-bottom pointer-events-none select-none"
            style="right: -24%;"
          />
        </div>
        <!-- Hero content -->
        <div class="relative flex flex-col items-start text-left" style="z-index: 1;">
          <h1 data-reveal-words data-hero-title class="hero-title font-bold leading-[0.94] tracking-[-0.035em] max-w-[12ch]" style="font-size: clamp(34px, min(7.6vw, 10.8vh), 116px)">
            Marcas que venden. Campañas que se recuerdan.
          </h1>
          <div class="hero-bottom mt-8 sm:mt-[clamp(20px,4vh,48px)] flex flex-col items-start gap-6 sm:gap-[clamp(16px,2.6vh,32px)]">
            <p data-hero-desc class="hero-desc text-[#a3a3a3] leading-[1.5] max-w-[46ch]" style="font-size: clamp(16px, min(1.5vw, 2.4vh), 21px)">
              Construimos identidad, sitios y campañas que convierten atención en clientes.
            </p>
            <div data-hero-cta class="flex gap-[10px] sm:gap-[14px] flex-wrap shrink-0">
              <a href="#contacto" class="inline-flex items-center gap-[10px] bg-[#f5f5f5] text-[#111111] text-[14px] sm:text-[15px] font-semibold px-5 sm:px-[26px] py-[13px] sm:py-[15px] rounded-full hover:bg-[#d4d4d4] transition-colors">
                Empezar un proyecto <span class="svc-arrow">↗</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- MARQUEE BAND — a todo el ancho, cerrando el hero -->
      <div data-hero-marquee class="relative border-t border-[#2a2a2a] border-b overflow-hidden bg-[#111111]" style="z-index: 1;">
        <Marquee variant="minimal" client:load items={marqueeItems} />
      </div>
    </section>

    <!-- SERVICIOS — banda negra a todo el ancho, carrusel horizontal.
         El titulo va en su contenedor de 1320px; el track sale a ancho
         completo para poder recorrer toda la pantalla y se realinea con el
         titulo mediante su propio `padding-inline` (ver `.svc-track`).
         Cada carta admite una imagen de fondo opcional: basta anadir `image`
         a su entrada del array `services` (ver `.svc-media`). -->
    <section id="servicios" class="section-full bg-[#0a0a0a] text-[#fafafa]" data-services>
      <div class="w-full max-w-[1320px] mx-auto px-4 sm:px-6 md:px-8 pt-14 sm:pt-[clamp(56px,9vh,104px)]">
        <div class="flex justify-between items-end flex-wrap gap-4 mb-6 sm:mb-8">
          <h2 data-services-title data-reveal-words class="font-extrabold tracking-[-0.03em] leading-none" style="font-size: clamp(26px, min(4vw, 7vh), 56px)">Servicios</h2>
          <!-- Referencia de avance: con una tarjeta por pantalla y sin
               scrollbar visible, si no es facil perder la cuenta. -->
          <div class="svc-progress-rail" aria-hidden="true">
            <span data-svc-progress class="svc-progress-bar"></span>
          </div>
        </div>
      </div>

      <div data-svc-viewport class="svc-viewport">
        <div data-svc-track class="svc-track">
          {services.map((s) => (
            <a href="/servicios" data-svc-card class="svc-card">
              {s.image && (
                <span class="svc-media" aria-hidden="true">
                  <img src={s.image} alt="" loading="lazy" decoding="async" />
                </span>
              )}
              {/* `relative z-[1]`: `.svc-media` es `absolute` y sin esto taparia
                  al contenido en flujo. */}
              <span class="svc-num relative z-[1] font-space-mono text-[12px] sm:text-[14px] opacity-[0.55]">{s.num}</span>
              <div class="mt-auto relative z-[1]">
                <h3 class="svc-title font-bold tracking-[-0.025em] leading-[1.02]" style="font-size: clamp(28px, min(5.5vw, 8vh), 68px)">{s.title}</h3>
                <p class="svc-desc mt-4 max-w-[52ch] leading-[1.5] opacity-70" style="font-size: clamp(14px, min(1.7vw, 2.6vh), 19px)">{s.desc}</p>
              </div>
              <span class="svc-arrow absolute z-[1] top-[clamp(20px,3vw,44px)] right-[clamp(20px,3vw,44px)]">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- PROCESO -->
    <!-- <section id="proceso" class="section-full max-w-[1320px] mx-auto px-4 sm:px-6 md:px-8 py-14 sm:py-[clamp(48px,7.5vh,84px)]">
      <div class="flex justify-between items-end flex-wrap gap-4 mb-8 sm:mb-12">
        <h2 data-reveal-words class="font-extrabold tracking-[-0.03em] leading-none max-w-[16ch]" style="font-size: clamp(26px, min(4vw, 7vh), 56px)">Un método claro, sin sorpresas</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-[#2a2a2a] border border-[#2a2a2a]">
        {steps.map((step, i) => (
          <div class="bg-[#1a1a1a] hover:bg-[#252525] transition-colors pt-7 sm:pt-8 px-5 sm:px-[26px] pb-8 sm:pb-10 min-h-[180px] sm:min-h-[clamp(170px,26vh,220px)] flex flex-col justify-between">
            <span class="font-space-mono text-[13px] text-[#8a8a8a]">{step.num}</span>
            <div>
              <h3 class="text-[18px] sm:text-[20px] font-bold tracking-[-0.01em] mb-[10px]">{step.title}</h3>
              <p class="text-[13.5px] sm:text-[14.5px] leading-[1.5] text-[#a3a3a3]">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section> -->

    <!-- TRABAJO -->
    <section id="trabajo" class="section-full max-w-[1320px] mx-auto px-4 sm:px-6 md:px-8 pt-6 sm:pt-10 pb-14 sm:pb-[clamp(48px,7.5vh,84px)]">
      <div class="flex justify-between items-end flex-wrap gap-4 mb-8 sm:mb-10">
        <h2 data-reveal-words class="font-extrabold tracking-[-0.03em] leading-none" style="font-size: clamp(26px, min(4vw, 7vh), 56px)">Trabajo</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-7">
        {work.map((project, i) => (
          <a
            href={project.link ?? '#contacto'}
            target={project.link ? '_blank' : undefined}
            rel={project.link ? 'noopener noreferrer' : undefined}
            class="block group"
          >
            <div class="work-placeholder relative aspect-[4/3] sm:max-h-[clamp(150px,28vh,420px)] border border-[#2a2a2a] group-hover:border-[#f5f5f5] transition-colors rounded-[4px] overflow-hidden">
              {project.image ? (
                <img src={project.image} alt={project.name} class="absolute inset-0 w-full h-full object-cover" />
              ) : (
                <span class="absolute left-4 bottom-[14px] font-space-mono text-[11px] text-[#6a6a6a] bg-[#1a1a1a] px-2 py-1 rounded">
                  imagen del proyecto
                </span>
              )}
            </div>
            <div class="flex justify-between items-baseline mt-4 pb-[14px] border-b border-[#2a2a2a]">
              <div>
                <h3 class="text-[18px] sm:text-[21px] font-bold tracking-[-0.01em]">{project.name}</h3>
                <p class="text-[13px] sm:text-[14px] text-[#8a8a8a] mt-[3px]">{project.tag}</p>
              </div>
              <span class="font-space-mono text-[12px] sm:text-[13px] text-[#8a8a8a]">{project.year}</span>
            </div>
          </a>
        ))}
      </div>
      <div class="flex justify-center mt-10 sm:mt-[clamp(32px,5vh,56px)]">
        <a href="#trabajo" class="inline-flex items-center gap-[10px] border border-[#f5f5f5] text-[14px] sm:text-[15px] font-semibold px-6 sm:px-[30px] py-[13px] sm:py-[15px] rounded-full hover:bg-[#f5f5f5] hover:text-[#111111] transition-colors duration-200">
          Ver todos los proyectos <span class="svc-arrow">↗</span>
        </a>
      </div>
    </section>

    <!-- ESTUDIO -->
    <section id="estudio" class="section-full border-t border-[#2a2a2a] bg-[#111111]">
      <div class="max-w-[1320px] mx-auto px-4 sm:px-6 md:px-8 py-14 sm:py-[clamp(48px,8vh,96px)] grid grid-cols-1 md:grid-cols-[0.8fr_1.4fr] gap-8 md:gap-12">
        <p class="font-space-mono text-[11px] sm:text-[12.5px] text-[#8a8a8a] tracking-[0.04em]">[ EL ESTUDIO ]</p>
        <div>
          <p class="leading-[1.28] tracking-[-0.02em] font-medium mb-10 sm:mb-14" style="font-size: clamp(20px, min(3vw, 5vh), 40px)">
            Creemos en el diseño con propósito. Cada proyecto une <strong class="font-extrabold">estética</strong> y <strong class="font-extrabold">estrategia</strong> para que tu marca no solo se vea bien — funcione y crezca.
          </p>
          <div class="flex gap-8 sm:gap-14 flex-wrap border-t border-[#2a2a2a] pt-8">
            <div>
              <div class="text-[36px] sm:text-[44px] font-extrabold tracking-[-0.03em]">+40</div>
              <div class="text-[13px] sm:text-[14px] text-[#8a8a8a] mt-1">proyectos entregados</div>
            </div>
            <div>
              <div class="text-[36px] sm:text-[44px] font-extrabold tracking-[-0.03em]">8 años</div>
              <div class="text-[13px] sm:text-[14px] text-[#8a8a8a] mt-1">de experiencia combinada</div>
            </div>
            <div>
              <div class="text-[36px] sm:text-[44px] font-extrabold tracking-[-0.03em]">100%</div>
              <div class="text-[13px] sm:text-[14px] text-[#8a8a8a] mt-1">enfoque a resultados</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section id="contacto" class="section-full bg-[#0a0a0a] text-[#fafafa]">
      <div class="max-w-[1320px] mx-auto px-4 sm:px-6 md:px-8 py-16 sm:py-[clamp(56px,10vh,112px)]">
        <h2 data-reveal-words class="font-extrabold leading-[0.95] tracking-[-0.035em] max-w-[13ch]" style="font-size: clamp(34px, min(8vw, 13vh), 116px)">¿Hacemos crecer tu marca?</h2>
        <div class="flex flex-col sm:flex-row flex-wrap gap-6 sm:gap-10 justify-between items-start sm:items-end mt-10 sm:mt-[clamp(32px,5vh,56px)]">
          <a href="mailto:hola@shapeandcode.agency" class="font-semibold tracking-[-0.02em] border-b-2 border-[#8a8a8a] pb-[6px] hover:border-[#fafafa] transition-colors break-all" style="font-size: clamp(15px, min(3vw, 5vh), 38px)">
            hola@shapeandcode.agency
          </a>
          <a href="mailto:hola@shapeandcode.agency" class="inline-flex items-center gap-3 bg-[#fafafa] text-[#0a0a0a] text-[14px] sm:text-[16px] font-bold px-6 sm:px-8 py-4 sm:py-[18px] rounded-full hover:bg-[#d4d4d4] transition-colors shrink-0">
            Escribir un mensaje <span class="svc-arrow">↗</span>
          </a>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="bg-[#0a0a0a] text-[#fafafa] border-t border-[#1f1f1f]">
      <div class="max-w-[1320px] mx-auto px-4 sm:px-6 md:px-8 py-8 sm:py-11 flex flex-col sm:flex-row flex-wrap gap-5 sm:gap-6 justify-between items-start sm:items-center">
        <div class="flex items-center gap-3">
          <img src="/assets/mark-black.png" alt="" class="h-6 w-auto" style="filter: invert(1)" />
          <span class="font-extrabold text-[14px] tracking-[0.04em]">SHAPE AND CODE</span>
        </div>
        <div class="flex gap-4 sm:gap-[26px] text-[13px] sm:text-[13.5px] text-[#a3a3a3] flex-wrap">
          <a href="#" class="hover:text-[#fafafa] transition-colors">Instagram</a>
          <a href="#" class="hover:text-[#fafafa] transition-colors">Behance</a>
          <a href="#" class="hover:text-[#fafafa] transition-colors">LinkedIn</a>
        </div>
        <p class="font-space-mono text-[12px] text-[#737373]">© {year} — ESTUDIO CREATIVO</p>
      </div>
    </footer>

  </main>
  </div>
  </div>

  <script>
    import { initScrollSmooth, destroyScrollSmooth } from '../scripts/scrollSmooth';
    import { initParallax, destroyParallax } from '../scripts/parallax';
    import { initServicesCarousel, destroyServicesCarousel } from '../scripts/servicesCarousel';
    import { initNavMorph, destroyNavMorph } from '../scripts/navMorph';
    import { initTextReveal, destroyTextReveal } from '../scripts/textReveal';
    import { initHeroIntro, destroyHeroIntro } from '../scripts/animations/heroIntro';

    // `astro:page-load` cubre la carga inicial y cada navegacion con
    // ViewTransitions; `astro:before-swap` limpia listeners y ScrollTriggers
    // antes de que el DOM se reemplace.
    //
    // El orden importa: `initScrollSmooth` va primero porque `initParallax`
    // registra sus efectos contra esa instancia, y los modulos dirigidos por
    // scroll van al final para que sus ScrollTriggers midan el DOM ya montado.
    document.addEventListener('astro:page-load', () => {
      initScrollSmooth();
      initNavMorph();
      // La intro del hero se queda con el H1 (`data-hero-title`); textReveal
      // cubre el resto de titulos con `data-reveal-words`.
      initHeroIntro();
      initTextReveal();
      initParallax();
      initServicesCarousel();
    });
    document.addEventListener('astro:before-swap', () => {
      destroyServicesCarousel();
      destroyParallax();
      destroyTextReveal();
      destroyHeroIntro();
      destroyNavMorph();
      destroyScrollSmooth();
    });
  </script>

  <style>
    /* ---- HERO TITLE LEGIBILITY (solo móvil) ----
       En móvil la imagen decorativa (el conejo) se solapa con el título.
       Añadimos un halo de texto para que resalte sobre la imagen: en modo
       claro el texto es oscuro -> halo claro; en oscuro es claro -> halo
       oscuro. Encima de sm (640px) hay espacio de sobra y no hace falta. */
    @media (max-width: 639px) {
      .hero-title {
        text-shadow:
          0 0 20px rgba(0, 0, 0, 0.85),
          0 0 7px rgba(0, 0, 0, 0.8),
          0 2px 4px rgba(0, 0, 0, 0.62);
      }
      /* Halo más ligero para el texto descriptivo (fuente más pequeña). */
      .hero-desc {
        text-shadow:
          0 0 14px rgba(0, 0, 0, 0.9),
          0 0 5px rgba(0, 0, 0, 0.85);
      }
    }

    /* ---- CARRUSEL DE SERVICIOS ----

       Por defecto el viewport es un scroller horizontal nativo con snap: ese
       es el estado sin JS y con `prefers-reduced-motion`, y se arrastra a mano
       perfectamente. `scripts/servicesCarousel.ts` añade `.is-pinned` cuando
       toma el control y apaga ese scroll para que no compita con el tween. */
    .svc-viewport {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      /* La barra de progreso ya indica el avance; la scrollbar nativa sobra. */
      scrollbar-width: none;
      padding-bottom: clamp(40px, 6vh, 64px);
    }
    .svc-viewport::-webkit-scrollbar { display: none; }
    .svc-viewport.is-pinned { overflow-x: hidden; scroll-snap-type: none; }

    .svc-track {
      display: flex;
      gap: clamp(14px, 1.6vw, 28px);
      /* Alinea la primera tarjeta con el título (que vive en un contenedor de
         1320px) aunque el track vaya a ancho completo. */
      padding-inline: max(1rem, calc((100vw - 1320px) / 2 + 1rem));
    }
    @media (min-width: 640px) { .svc-track { padding-inline: max(1.5rem, calc((100vw - 1320px) / 2 + 1.5rem)); } }
    @media (min-width: 768px) { .svc-track { padding-inline: max(2rem, calc((100vw - 1320px) / 2 + 2rem)); } }

    .svc-card {
      position: relative;
      flex: 0 0 auto;
      width: min(86vw, 1040px);
      min-height: clamp(300px, 52vh, 560px);
      scroll-snap-align: center;
      display: flex;
      flex-direction: column;
      padding: clamp(20px, 3vw, 44px);
      border: 1px solid #2a2a2a;
      border-radius: 4px;
      isolation: isolate;
      transition: background-color 0.3s, border-color 0.3s;
    }
    /* Sin imagen el zoom no aplica: un fondo discreto da la respuesta al hover.
       Con imagen esta capa queda tapada por `.svc-media`, asi que no estorba. */
    .svc-card:hover { background: #1a1a1a; }

    /* ---- IMAGEN DE FONDO DE LA CARTA ----
       Capa propia (y no `background-image` de la carta) porque el hover escala
       la imagen y el degradado de legibilidad NO debe escalar con ella. */
    .svc-media {
      position: absolute;
      /* `inset: 0` se posiciona al padding box: el borde de la carta queda visible. */
      inset: 0;
      z-index: 0;
      overflow: hidden;
      border-radius: inherit;
    }
    .svc-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      display: block;
      transform: scale(1);
      transition: transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
    }
    .svc-card:hover .svc-media img { transform: scale(1.05); }

    @media (prefers-reduced-motion: reduce) {
      .svc-media img { transition: none; }
      .svc-card:hover .svc-media img { transform: none; }
    }

    /* Degradado de legibilidad: el texto va en #fafafa abajo a la izquierda.
       Uno vertical para titulo/descripcion y otro horizontal para el resto de
       la columna de texto. */
    .svc-media::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        linear-gradient(to top, rgba(10,10,10,0.92) 0%, rgba(10,10,10,0.55) 45%, rgba(10,10,10,0.15) 100%),
        linear-gradient(to right, rgba(10,10,10,0.75) 0%, rgba(10,10,10,0) 60%);
    }

    .svc-progress-rail { width: clamp(80px, 18vw, 220px); height: 2px; background: #2a2a2a; }
    .svc-progress-bar {
      display: block;
      height: 100%;
      background: #fafafa;
      transform: scaleX(0);
      transform-origin: left center;
    }

    /* ---- WORK PLACEHOLDER ---- */
    .work-placeholder {
      background-color: #1a1a1a;
      background-image: repeating-linear-gradient(135deg, #2a2a2a 0 2px, transparent 2px 11px);
    }
  </style>

</body>
